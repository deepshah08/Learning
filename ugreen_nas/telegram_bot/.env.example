# ==============================================================================
# Telegram Media Automation Bot Configuration (.env)
# ==============================================================================

# 1. Telegram Bot Token (Obtained in 30s from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Allowed Telegram User IDs (Comma-separated list of authorized users)
# Leave empty initially to see your User ID printed on /start
ALLOWED_TELEGRAM_USER_IDS=

# 3. LLM API Key (For Natural Language Intent Parsing)
# Supports Google Gemini API (Recommended: free tier Gemini 2.0 Flash) or OpenAI
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# 4. Arr Stack API Keys (Pre-configured for your UGREEN DXP2800 NAS)
RADARR_URL=http://192.168.1.80:7878
RADARR_API_KEY=30ad1ab196a04184b11289e39a695f20

SONARR_URL=http://192.168.1.80:8989
SONARR_API_KEY=7385f68a846a416d9964d08d1eccda12

PROWLARR_URL=http://192.168.1.80:9696
PROWLARR_API_KEY=eb674050f3e24beaa54b515dbb7a01ac

# 5. Plex Settings
PLEX_URL=http://192.168.1.80:32400
PLEX_TOKEN=

# 6. Library Storage Paths on NAS
MOVIES_ROOT_FOLDER=/data/media/movies
TV_ROOT_FOLDER=/data/media/tv
