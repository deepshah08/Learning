# Email Agent — Environment Config
# Copy this file to: config/.env
# Fill in your values — never commit this file

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → get BOT_TOKEN
# 2. Message @userinfobot on Telegram → get your CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini Teacher Audit (Optional Accuracy Feedback Loop) ───────────────────
# Google AI Studio API key for post-batch disambiguation (e.g. Finance vs Shopping)
# Free tier: 15 RPM / 1,500 RPD
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_AUDIT_MAX=8

# ── Gmail (handled via OAuth — credentials/token_<label>.json) ─────────────────
